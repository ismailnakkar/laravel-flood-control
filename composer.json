{
    "name": "ismailnakkar/laravel-flood-control",
    "description": "One rate limit for reported exceptions, applied before the log write and before Sentry.",
    "keywords": [
        "laravel",
        "exceptions",
        "throttle",
        "rate-limit",
        "sentry",
        "logging"
    ],
    "homepage": "https://github.com/ismailnakkar/laravel-flood-control",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ismail Nakkar",
            "email": "juge.steam@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/ismailnakkar/laravel-flood-control/issues"
    },
    "require": {
        "php": "^8.5",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "laravel/pulse": "^1.8",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "laravel/pulse": "Keeps an unthrottled exception rate signal alongside the throttled reports."
    },
    "autoload": {
        "psr-4": {
            "FloodControl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FloodControl\\Tests\\": "tests/"
        },
        "files": [
            "tests/Fixtures/exceptions.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FloodControl\\FloodControlServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
